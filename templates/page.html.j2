<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>GitHub {{ "每週" if ptype == "weekly" else "每月" }}熱門五選{% if pid %} {{ pid }}{% endif %}</title>
<style>
{% include "_style.css.j2" %}
</style>
</head>
<body>
<div class="wrap">

<nav class="tabs">
  <a href="{{ root }}index.html" class="{{ 'on' if ptype == 'weekly' and not is_archive }}">本週精選</a>
  <a href="{{ root }}monthly.html" class="{{ 'on' if ptype == 'monthly' and not is_archive }}">本月精選</a>
  <a href="{{ root }}history.html" class="right">推薦紀錄</a>
</nav>

{% if not wd %}
<header class="top"><h1>{{ "每週熱門" if ptype == "weekly" else "每月熱門" }}</h1></header>
<p class="empty-page">{{ "第一份週精選會在週一產生。" if ptype == "weekly" else "第一份月度精選會在每月 1 日產生。" }}</p>
{% else %}

<header class="top">
  <h1>{{ title }}</h1>
  <p class="facts">{{ facts[0] }}</p>
  <p class="facts-2">{{ facts[1] }}</p>
  {% if is_archive %}<div class="archive-note">這是過往{{ "週次" if ptype == "weekly" else "月份" }}的存檔　<a href="{{ root }}{{ 'index' if ptype == 'weekly' else 'monthly' }}.html">回到最新{{ "一週" if ptype == "weekly" else "一個月" }}</a></div>{% endif %}
  <div class="rec-line">
    {% if recommended %}
    <span class="names"><b>{{ label }}推薦安裝：</b>{{ recommended|join("、") }}</span>
    {% else %}
    <span class="names muted">本期沒有推薦安裝的項目</span>
    {% endif %}
    <label class="switch"><input type="checkbox" id="only-rec"> 只看推薦</label>
  </div>
</header>

<h2 class="section">精選</h2>
<p class="only-rec-empty">本期沒有推薦安裝的項目。</p>

{% for p in wd.projects %}
{% set pr = p.practicality %}
{% set risks = p.risk_notes or [] %}
{% set rec = p.recommend or {} %}
{% set main_risk = risks|selectattr("scope", "equalto", "主要用途")|list %}
<article class="item{% if main_risk %} has-risk{% endif %}{% if rec.badge %} rec{% endif %}" id="p{{ p.rank }}">
  {% if rec.badge %}<div class="tag-kraft{% if rec.has_misuse_risk %} with-note{% endif %}">推薦安裝{% if rec.has_misuse_risk %}<small>先看注意事項</small>{% endif %}</div>{% endif %}

  <div class="price">
    <span class="rank">No.{{ p.rank }}</span>
    {% set g = period_gain(p) %}
    <span class="gain{% if g[1] %} est{% endif %}">{{ g[0] }}</span>
    <span class="gain-label">{{ label }}新增星數{% if g[1] %}（估）{% endif %}</span>
    <dl>
      <dt>總星數</dt><dd>★ {{ num(p.stars_total) }}</dd>
      <dt>健康度</dt><dd class="health h-{{ health_class(p.health.score) }}">健康度 {{ p.health.score }}</dd>
      <dt>語言</dt><dd>{{ p.language or "語言不明" }}</dd>
      <dt>授權</dt><dd>{{ p.license or "無授權" }}</dd>
    </dl>
  </div>

  <div class="body">
    <a class="name" href="{{ p.url }}" target="_blank" rel="noopener">{{ repo_wbr(p.full_name) }}</a>
    <div class="kind">{{ slot_label(p.slot) }} ｜ {{ p.category }}{% if p.matched_interest %} ｜ {{ p.matched_interest }}{% endif %}{% if risks %} ｜ <span style="color: var(--caution)">注意事項 {{ risks|length }}</span>{% endif %}</div>
    {% if p.health.flags %}<div class="flags">{% for f in p.health.flags %}<span class="f-{{ flag_class(f) }}">{{ f }}</span>{% endfor %}</div>{% endif %}
    {% if p.intro_status != "ai" %}<p class="fallback">AI 介紹未產生，以下是官方原文</p>{% endif %}
    <p class="one-liner">{{ p.intro.one_liner }}</p>
    {% if rec.badge and rec.llm_reason %}<p class="reason">{{ rec.llm_reason }}</p>{% endif %}
    <p class="specs">{% for s in specs(pr) %}<span class="s-{{ s[1] }}">{{ s[0] }}</span>{% endfor %}</p>
    <p class="verdict"><b>值不值得試：</b>{{ pr.verdict }}</p>

    <details class="more">
      <summary>展開完整介紹</summary>
      {% if risks %}
      <div class="risk-box">
        <h3>注意事項</h3>
        <ul>{% for r in risks %}<li>【{{ r.type }}】{{ r.note }}{% if r.scope %} <span class="scope">（{{ "正常用法就有這個風險" if r.scope == "主要用途" else "被不當使用時才有風險" }}）</span>{% endif %}</li>{% endfor %}</ul>
      </div>
      {% endif %}
      <div class="block">
        <h3>介紹</h3>
        <dl class="kv">
          <dt>解決什麼問題</dt><dd>{{ p.intro.problem }}</dd>
          <dt>主要功能</dt><dd><ul>{% for f in p.intro.features %}<li>{{ f }}</li>{% endfor %}</ul></dd>
          <dt>適合誰</dt><dd>{{ p.intro.audience }}</dd>
          <dt>怎麼開始</dt><dd>{{ p.intro.getting_started }}</dd>
          <dt>使用技術</dt><dd>{{ p.intro.tech_stack }}</dd>
          <dt>為什麼紅</dt><dd>{{ p.intro.why_trending }}</dd>
        </dl>
        {% if p.intro_status != "ai" and p.description_raw %}<p><span class="muted">官方原文描述：</span>{{ p.description_raw }}</p>{% endif %}
        {% if p.ideas_for_me %}
        <h3>可以怎麼用在我的專案</h3>
        {% for i in p.ideas_for_me %}<div class="idea"><span class="muted">{{ i.interest }}</span><br>{{ i.idea }}</div>{% endfor %}
        {% endif %}
        {% if p.glossary %}
        <h3>名詞解釋</h3>
        <dl class="kv">{% for g in p.glossary %}<dt>{{ g.term }}</dt><dd>{{ g.explain }}</dd>{% endfor %}</dl>
        {% endif %}
      </div>
      <details class="trial">
        <summary>給 Claude Code 的試用指令</summary>
        <div class="trial-tools">
          <button type="button" class="copy" data-target="prompt-{{ p.rank }}">複製</button>
          <span class="copied" aria-live="polite"></span>
        </div>
        <pre class="prompt" id="prompt-{{ p.rank }}">{{ p.trial_prompt }}</pre>
      </details>
    </details>

    {% if p.reused_from or p.lite_model %}
    <div class="foot">{% if p.reused_from %}<span>介紹沿用 {{ p.reused_from }} 週精選</span>{% endif %}{% if p.lite_model %}<span>本則由輕量模型產生</span>{% endif %}</div>
    {% endif %}
  </div>
</article>
{% endfor %}

<section id="quick-section">
<h2 class="section">速覽<small>其他新品</small></h2>
<div class="q-head"><span>名稱</span><span>一句話</span><span class="q-r">{{ label }}新增</span><span class="q-r">健康度</span></div>
{% for q in wd.quick_picks %}
{% set qr = q.recommend or {} %}
<div class="q-row">
  <div>
    <a class="q-name" href="{{ q.url }}" target="_blank" rel="noopener">{{ repo_wbr(q.full_name) }}</a>
    <div class="q-sub">{{ q.category }} ｜ {{ q.language or "語言不明" }} ｜ ★ <span class="num">{{ num(q.stars_total) }}</span>{% if q.lite_model %} ｜ 輕量模型產生{% endif %}</div>
    {% if qr.maybe_fit or q.flags or q.risk_flag %}
    <div class="q-marks">{% if qr.maybe_fit %}<span class="maybe" title="{{ qr.llm_reason }}">可能適合</span>{% endif %}{% for f in q.flags or [] %}<span class="f-{{ flag_class(f) }}">{{ f }}</span>{% endfor %}{% if q.risk_flag %}<span style="color: var(--caution)">{{ q.risk_flag }}</span>{% endif %}</div>
    {% endif %}
  </div>
  <div class="q-line">{{ q.one_liner }}</div>
  <div class="q-r q-gain num">{{ period_stars(q) }}</div>
  <div class="q-r q-health num h-{{ health_class(q.health_score) }}"><span class="m-only">健康度 </span>{{ q.health_score }}</div>
</div>
{% endfor %}
</section>
{% endif %}

<h2 class="section" id="archive">過往存檔</h2>
<dl class="arch">
  <dt>週</dt>
  <dd>{% for w in weeks %}<a href="{{ root }}archive/{{ w }}.html"{% if w == pid and ptype == "weekly" %} class="current" aria-current="page"{% endif %}>{{ w }}</a>{% else %}<span class="muted">尚無週次存檔</span>{% endfor %}</dd>
  <dt>月</dt>
  <dd>{% for m in months %}<a href="{{ root }}archive/{{ m }}.html"{% if m == pid and ptype == "monthly" %} class="current" aria-current="page"{% endif %}>{{ m }}</a>{% else %}<span class="muted">尚無月度存檔</span>{% endfor %}</dd>
</dl>
<p class="all-history"><a href="{{ root }}history.html">查看全部推薦紀錄 ›</a></p>

<footer>
  資料來源：GitHub Trending 與 GitHub API。中文介紹由 Gemini 產生，可能有誤，請以官方 README 為準。健康度依最近更新、commit 活躍度、貢獻者、fork 比例、正式版本、授權計算。「推薦安裝」需同時通過 AI 判斷與程式門檻：Windows 可用、免付費 API、難度不高、健康度足夠、沒有主要用途上的版權／法律／資安風險。
</footer>
</div>

<script>
(function () {
  function fallbackCopy(text) {
    var ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly", "");
    ta.style.position = "fixed";
    ta.style.top = "-1000px";
    document.body.appendChild(ta);
    ta.select();
    var ok = false;
    try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
    document.body.removeChild(ta);
    return ok;
  }
  function flash(el, msg) {
    el.textContent = msg;
    el.classList.add("show");
    clearTimeout(el._t);
    el._t = setTimeout(function () { el.classList.remove("show"); }, 3000);
  }
  document.querySelectorAll("button.copy").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var text = document.getElementById(btn.dataset.target).textContent;
      var note = btn.parentNode.querySelector(".copied");
      var done = function () { flash(note, "已複製"); };
      var fail = function () { flash(note, fallbackCopy(text) ? "已複製" : "複製失敗，請手動選取"); };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(done, fail);
      } else {
        fail();
      }
    });
  });
  var onlyRec = document.getElementById("only-rec");
  if (onlyRec) {
    onlyRec.checked = false;
    onlyRec.addEventListener("change", function () {
      document.body.classList.toggle("only-rec", onlyRec.checked);
    });
  }
})();
</script>
</body>
</html>
